{
  "name": "rowvision-desktop",
  "productName": "RowVision",
  "private": true,
  "version": "0.3.0",
  "description": "RowVision for Windows and Linux.",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "vite build && node build-main.mjs",
    "start": "electron .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:app": "playwright test",
    "dist": "npm run build && electron-builder",
    "test:packaged": "playwright test -c playwright.packaged.config.ts",
    "start:engine": "bash scripts/start-with-engine.sh"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "author": "RowVision",
  "homepage": "https://github.com/fionnmowlds07-a11y/RowVision"
}
