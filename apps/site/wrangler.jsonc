// Cloudflare settings for rowvision.app. The site is static files served by a Worker on the free plan.
// The clips and the installer are not here: they live in the R2 bucket rowvision-downloads, at downloads.rowvision.app,
// because Worker static files are not served in byte ranges and a video cannot be scrubbed without them.
// worker/index.js runs only for /get/*, to count downloads in the D1 database before sending people to R2.
{
  "name": "rowvision",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/get/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "rowvision-downloads", "database_id": "f505307a-d5ca-466e-b305-5f859782e80d" }
  ],
  "routes": [
    { "pattern": "rowvision.app", "custom_domain": true },
    { "pattern": "www.rowvision.app", "custom_domain": true }
  ]
}
